# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional extra keys: used automatically when the first key's quota runs out
GEMINI_API_KEY_2=
# Models tried in order on rate limits
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview

# FalkorDB Cloud (https://app.falkordb.cloud) or local docker
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false

PORT=3000
# Set to true to run the agents without an LLM (deterministic graph playbooks)
GRAPHOPS_SCRIPTED=false
GEMINI_THINKING=low

# Real-world actions (optional). Without these, approved actions are dry runs.
ACTION_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=
